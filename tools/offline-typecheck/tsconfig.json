{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    "typeRoots": ["/home/claude/.npm-global/lib/node_modules/ts-node/node_modules/@types"],
    "paths": { "@/*": ["../../src/*"] }
  },
  "include": ["../../src/**/*", "../../electron/**/*", "shims/*.d.ts"]
}
